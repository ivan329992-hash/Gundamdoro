    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.13.0",
